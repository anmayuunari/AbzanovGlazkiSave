<Window x:Class="AbzanovGlazki.ProductHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AbzanovGlazki"
        mc:Ignorable="d"
        Title="Product History" Height="450" Width="800" FontFamily="Century Gothic" Icon="res/Глазки-save.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Продукт" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center"/>
        <TextBlock Text="Дата" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center"/>
        <TextBlock Text="Количество" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Center"/>

        <Button Content="Добавить" Name="AddProductHistoryButton" Click="AddProductHistoryButton_Click"/>

        <ListView Name="ProductHistoryListView" Grid.Row="2" Grid.ColumnSpan="3" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ProductFullName}" Grid.Column="0" HorizontalAlignment="Left" FontSize="20"/>
                        <TextBlock Text="{Binding SaleDate}" Grid.Column="1" HorizontalAlignment="Right" FontSize="20" Margin="15,0"/>
                        <TextBlock Text="{Binding ProductCount}" Grid.Column="2" HorizontalAlignment="Right" FontSize="20" Margin="5,0"/>

                        <StackPanel Orientation="Horizontal" Grid.Column="3" Grid.Row="3" HorizontalAlignment="Right">
                            <Button Content="Удалить" Name="DeleteProductHistoryButton" Width="90" Margin="3,0" Click="DeleteProductHistoryButton_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Window>
