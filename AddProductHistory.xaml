<Window x:Class="AbzanovGlazki.AddProductHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AbzanovGlazki"
        mc:Ignorable="d"
        Title="Add Product History" Height="450" Width="800" FontFamily="Century Gothic" Icon="res/Глазки-save.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название продукта" FontSize="20" Grid.Row="0"/>
        <TextBlock Text="Дата" FontSize="20" Grid.Row="1"/>
        <TextBlock Text="Количество" FontSize="20" Grid.Row="2"/>

        
        <ComboBox Name="ProductFullNameComboBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" DisplayMemberPath="Title" Grid.Column="1" Grid.Row="0" Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <DatePicker Grid.Column="1" Grid.Row="1" Height="30" Width="200"  SelectedDate="{Binding SaleDate}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox Grid.Column="1" Grid.Row="2" Height="30" Width="200" Text="{Binding ProductCount}" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Button Content="Добавить" Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" Name="AddProductHistoryButton" Click="AddProductHistoryButton_Click"/>

    </Grid>
</Window>
